# =========================================================================
# EstrelaClick - Variáveis de Ambiente (.env)
# =========================================================================
# Este arquivo serve como modelo de configuração para o ecossistema EstrelaClick.
# Copie este arquivo para '.env' no diretório raiz e personalize conforme seu ambiente:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/macOS (Bash):   cp .env.example .env
#
# NOTA: O arquivo '.env' está incluído no .gitignore e NUNCA deve ser commitado com credenciais reais.
# =========================================================================

# Ambiente de Execução ASP.NET Core (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# =========================================================================
# 1. Banco de Dados SQL Server & EF Core 10
# =========================================================================
# String de conexão principal da Web API
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=estrelaclick;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True;Encrypt=False

# Senha de administrador do contêiner SQL Server (Docker Compose)
MSSQL_SA_PASSWORD=Your_strong_password123

# Executar automaticamente migrações pendentes do EF Core no arranque da API (true/false)
Database__AutoMigrate=true

# Conexão com Redis (Docker Compose / Cache L2 para HybridCache)
Redis__ConnectionString=localhost:6379

# =========================================================================
# 2. Segurança, Autenticação e Criptografia
# =========================================================================
# Chave secreta simétrica para assinatura de tokens JWT dos operadores de bancada (.NET MAUI)
Jwt__SecretKey=chave-super-secreta-padrao-jwt-bancada-2026-estrelaclick

# Chave estática de API para integração industrial/fábrica (Header: X-Api-Key)
FactorySecurity__ApiKey=dev-factory-secret-key-2026

# Credenciais do operador padrão de bancada para provisionamento inicial
FactorySecurity__DefaultOperator__Login=operador
FactorySecurity__DefaultOperator__Password=operador123

# Salt utilizado na anonimização de IP conforme LGPD/GDPR
Security__IpHashSalt=EstrelaClick_Default_Salt_2026

# =========================================================================
# 3. Motor de Redirecionamento e QR Code
# =========================================================================
# URL base pública para os redirecionamentos gravados no chip NFC / QR Code (/r/{slug})
QrCode__BaseRedirecionamentoUrl=https://localhost:7157/r
App__BaseRedirectUrl=https://localhost:7157/r

# URL base do Dashboard do Cliente (para onde placas virgens são direcionadas no onboarding)
ClientDashboard__BaseUrl=https://localhost:7198

# =========================================================================
# 4. Comunicação entre Frontends e API Backend
# =========================================================================
# URL base da API utilizada pelo AdminDashboard e ClientDashboard
Api__BaseUrl=https://localhost:7157

# Chave de API utilizada pelo AdminDashboard para consumir endpoints gerenciais da API
Api__ApiKey=dev-factory-secret-key-2026

# =========================================================================
# 5. Logging Estruturado (Serilog)
# =========================================================================
# Nível mínimo padrão de log (Verbose, Debug, Information, Warning, Error, Fatal)
# Serilog__MinimumLevel__Default=Information
# Serilog__MinimumLevel__Override__Microsoft__AspNetCore=Warning
# Serilog__MinimumLevel__Override__Microsoft__EntityFrameworkCore__Database__Command=Warning

