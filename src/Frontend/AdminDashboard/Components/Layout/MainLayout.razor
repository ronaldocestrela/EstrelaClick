@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="admin-app-layout">
    <NavMenu />

    <div class="admin-main-wrapper">
        <header class="admin-topbar">
            <h1 class="admin-topbar-title">Gestão Fabril & Backoffice</h1>

            <div class="admin-topbar-actions">
                <button type="button" class="btn-token-icon" @onclick="ToggleThemeAsync" title="Alternar Modo Escuro/Claro" aria-label="Alternar Tema">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1" x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/>
                        <line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                </button>

                <AuthorizeView>
                    <Authorized>
                        <div style="display: flex; align-items: center; gap: var(--space-xs); font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <span style="font-weight: var(--font-weight-medium); color: var(--color-text-primary);">@(context.User.Identity?.Name ?? "Admin Master")</span>
                        </div>

                        <form action="/auth/admin-logout" method="post" style="display: inline-flex; margin: 0;">
                            <AntiforgeryToken />
                            <button type="submit" class="btn-token-icon" title="Encerrar Sessão (Sair)" aria-label="Encerrar Sessão">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/>
                                    <line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn-token-secondary" style="font-size: var(--font-size-xs); text-decoration: none; padding: var(--space-2xs) var(--space-sm);">Acessar</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="admin-content-area">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" style="display: none;">
    Ocorreu um erro não esperado.
    <a href="" class="reload">Recarregar</a>
</div>

@code {
    private async Task ToggleThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("toggleTheme");
        }
        catch
        {
            // Fallback se JS não estiver disponível no SSR inicial
        }
    }
}
