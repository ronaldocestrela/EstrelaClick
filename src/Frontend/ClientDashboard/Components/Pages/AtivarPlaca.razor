@page "/ativar"
@page "/ativar/{Slug}"
@rendermode InteractiveServer
@inject IClientApiClient ClientApi
@inject NavigationManager Navigation

<PageTitle>Ativar Placa NFC - EstrelaClick</PageTitle>

<div style="max-width: 680px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: var(--space-xl);">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius-full); background-color: var(--color-accent-subtle); color: var(--color-accent); margin-bottom: var(--space-md);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="16"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
            </svg>
        </div>
        <h2 style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); margin-bottom: var(--space-xs);">
            Ativação de Placa Inteligente
        </h2>
        <p style="color: var(--color-text-secondary); font-size: var(--font-size-sm);">
            Configure sua placa NFC e QR Code para começar a receber avaliações e clientes instantaneamente.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensagemErro))
    {
        <div class="alert-token alert-token-danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>@_mensagemErro</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_mensagemSucesso))
    {
        <div class="alert-token alert-token-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>@_mensagemSucesso</span>
        </div>
    }

    <div class="card-panel">
        @if (_carregando)
        {
            <div style="padding: var(--space-2xl); text-align: center;">
                <LoadingSpinner Message="Validando placa e estoque..." IsCentered="true" />
            </div>
        }
        else if (_placaVerificada is not null && !_placaVerificada.DisponivelParaAtivacao)
        {
            <div style="text-align: center; padding: var(--space-lg);">
                <div style="color: var(--color-warning-text); margin-bottom: var(--space-sm);">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-xs);">Esta placa já está ativada!</h3>
                <p style="color: var(--color-text-secondary); font-size: var(--font-size-sm); margin-bottom: var(--space-lg);">
                    Status atual: <strong>@_placaVerificada.StatusPlaca</strong>. Caso esta placa seja sua, gerencie o link no painel.
                </p>
                <a href="placas" class="btn-token-primary">Ver Minhas Placas</a>
            </div>
        }
        else
        {
            <form @onsubmit="SalvarAtivacaoAsync">
                @if (string.IsNullOrWhiteSpace(Slug))
                {
                    <div style="margin-bottom: var(--space-md);">
                        <label style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: var(--space-2xs);">
                            Identificador / Slug da Placa
                        </label>
                        <input type="text"
                               @bind="_slugInput"
                               placeholder="Ex: 8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d"
                               class="form-control"
                               style="width: 100%; padding: var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface); color: var(--color-text-primary);" />
                        <span style="font-size: var(--font-size-xs); color: var(--color-text-tertiary);">
                            Código gravado na tag NFC ou exibido no lote.
                        </span>
                    </div>
                }
                else
                {
                    <div class="alert-token alert-token-info" style="margin-bottom: var(--space-md);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        <span>Placa detectada por aproximação: <code>@Slug</code></span>
                    </div>
                }

                <div style="margin-bottom: var(--space-md);">
                    <label style="display: block; font-size: var(--font-size-sm); font-weight: 600; margin-bottom: var(--space-2xs);">
                        URL de Destino Inicial (Onde o cliente vai ao encostar o celular)
                    </label>
                    <input type="url"
                           required
                           @bind="_urlDestino"
                           placeholder="https://g.page/r/minha-loja/review"
                           style="width: 100%; padding: var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface); color: var(--color-text-primary);" />
                    
                    <div style="display: flex; gap: var(--space-xs); margin-top: var(--space-xs); flex-wrap: wrap;">
                        <button type="button" class="btn-token-secondary" style="font-size: var(--font-size-xs);" @onclick="@(() => PreencherExemplo("https://g.page/r/exemplo-google/review"))">
                            Google Avaliações
                        </button>
                        <button type="button" class="btn-token-secondary" style="font-size: var(--font-size-xs);" @onclick="@(() => PreencherExemplo("https://wa.me/5511999999999?text=Ol%C3%A1"))">
                            WhatsApp Comercial
                        </button>
                        <button type="button" class="btn-token-secondary" style="font-size: var(--font-size-xs);" @onclick="@(() => PreencherExemplo("https://instagram.com/sualoja"))">
                            Instagram / Catálogo
                        </button>
                    </div>
                </div>

                <div style="margin-top: var(--space-lg); border-top: 1px solid var(--color-border); padding-top: var(--space-md);">
                    <h4 style="font-size: var(--font-size-md); font-weight: 600; margin-bottom: var(--space-sm);">Dados da sua Loja / Empresa</h4>

                    <div style="margin-bottom: var(--space-sm);">
                        <label style="display: block; font-size: var(--font-size-sm); margin-bottom: var(--space-2xs);">Razão Social / Nome da Loja</label>
                        <input type="text"
                               required
                               @bind="_razaoSocial"
                               placeholder="Ex: Pizzaria Forno & Arte"
                               style="width: 100%; padding: var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface); color: var(--color-text-primary);" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); margin-bottom: var(--space-md);">
                        <div>
                            <label style="display: block; font-size: var(--font-size-sm); margin-bottom: var(--space-2xs);">Email de Contato</label>
                            <input type="email"
                                   required
                                   @bind="_email"
                                   placeholder="contato@pizzaria.com.br"
                                   style="width: 100%; padding: var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface); color: var(--color-text-primary);" />
                        </div>
                        <div>
                            <label style="display: block; font-size: var(--font-size-sm); margin-bottom: var(--space-2xs);">WhatsApp / Telefone</label>
                            <input type="tel"
                                   required
                                   @bind="_telefone"
                                   placeholder="(11) 98765-4321"
                                   style="width: 100%; padding: var(--space-sm); border: 1px solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface); color: var(--color-text-primary);" />
                        </div>
                    </div>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: var(--space-sm); margin-top: var(--space-lg);">
                    <button type="submit" class="btn-token-primary" disabled="@_salvando">
                        @if (_salvando)
                        {
                            <span>Ativando placa...</span>
                        }
                        else
                        {
                            <span>Ativar Placa Agora</span>
                        }
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? Slug { get; set; }

    private string _slugInput = string.Empty;
    private string _urlDestino = string.Empty;
    private string _razaoSocial = string.Empty;
    private string _email = string.Empty;
    private string _telefone = string.Empty;

    private bool _carregando;
    private bool _salvando;
    private string? _mensagemErro;
    private string? _mensagemSucesso;
    private VerificarOnboardingDto? _placaVerificada;

    protected override async Task OnParametersSetAsync()
    {
        var slugAlvo = !string.IsNullOrWhiteSpace(Slug) ? Slug : _slugInput;
        if (!string.IsNullOrWhiteSpace(slugAlvo))
        {
            await VerificarPlacaAsync(slugAlvo);
        }
    }

    private async Task VerificarPlacaAsync(string slug)
    {
        _carregando = true;
        _mensagemErro = null;

        try
        {
            var result = await ClientApi.VerificarOnboardingAsync(slug);
            if (result.IsSuccess && result.Value is not null)
            {
                _placaVerificada = result.Value;
                if (!string.IsNullOrWhiteSpace(_placaVerificada.UrlDestinoAtual))
                {
                    _urlDestino = _placaVerificada.UrlDestinoAtual;
                }
            }
            else
            {
                _mensagemErro = result.Error.Description;
            }
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Erro ao verificar placa: {ex.Message}";
        }
        finally
        {
            _carregando = false;
        }
    }

    private void PreencherExemplo(string url)
    {
        _urlDestino = url;
    }

    private async Task SalvarAtivacaoAsync()
    {
        var slugFinal = !string.IsNullOrWhiteSpace(Slug) ? Slug : _slugInput;

        if (string.IsNullOrWhiteSpace(slugFinal))
        {
            _mensagemErro = "Por favor, informe o slug da placa.";
            return;
        }

        _salvando = true;
        _mensagemErro = null;
        _mensagemSucesso = null;

        try
        {
            var request = new AtivarPlacaRequest(
                Slug: slugFinal.Trim(),
                UrlDestino: _urlDestino.Trim(),
                RazaoSocial: _razaoSocial.Trim(),
                Email: _email.Trim(),
                Telefone: _telefone.Trim()
            );

            var result = await ClientApi.AtivarOnboardingAsync(request);
            if (result.IsSuccess)
            {
                _mensagemSucesso = "Placa ativada com sucesso! Redirecionando para suas placas...";
                await Task.Delay(1500);
                Navigation.NavigateTo("placas");
            }
            else
            {
                _mensagemErro = result.Error.Description;
            }
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Erro na ativação: {ex.Message}";
        }
        finally
        {
            _salvando = false;
        }
    }
}
