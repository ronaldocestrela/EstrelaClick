@namespace EstrelaClick.Frontend.Shared.UI.Components.Feedback

<div class="empty-state">
    <div class="empty-icon-wrapper" aria-hidden="true">
        @if (Icon != null)
        {
            @Icon
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="default-empty-icon">
                <circle cx="12" cy="12" r="10"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
            </svg>
        }
    </div>
    <h4 class="empty-title">@Title</h4>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="empty-description">@Description</p>
    }
    @if (ActionContent != null)
    {
        <div class="empty-action">
            @ActionContent
        </div>
    }
</div>

<style>
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space-2xl) var(--space-lg);
        text-align: center;
        font-family: var(--font-family-base);
    }

    .empty-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-full);
        background-color: var(--color-surface-hover);
        color: var(--color-text-muted);
        margin-bottom: var(--space-md);
    }

    .default-empty-icon {
        width: 24px;
        height: 24px;
    }

    .empty-title {
        margin: 0 0 var(--space-xs) 0;
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        color: var(--color-text-primary);
    }

    .empty-description {
        margin: 0 0 var(--space-md) 0;
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
        max-width: 380px;
        line-height: var(--line-height-normal);
    }

    .empty-action {
        margin-top: var(--space-sm);
    }
</style>

@code {
    [Parameter]
    public string Title { get; set; } = "Nenhum registro encontrado";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Icon { get; set; }

    [Parameter]
    public RenderFragment? ActionContent { get; set; }
}
