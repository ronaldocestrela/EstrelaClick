<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EstrelaClick.Shared.SharedKernel.Mobile.ViewModels;assembly=EstrelaClick.Shared.SharedKernel"
             x:Class="EstrelaClick.Mobile.FactoryMobileApp.Views.LoginPage"
             BackgroundColor="{StaticResource EstrelaBackground}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="32,60,32,40" VerticalOptions="Center">
            
            <!-- Logo / Cabeçalho -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="EstrelaClick"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{StaticResource EstrelaAccent}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Terminal de Bancada Fabril"
                       FontSize="16"
                       TextColor="{StaticResource EstrelaTextSecondary}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Card de Autenticação -->
            <Border BackgroundColor="{StaticResource EstrelaSurface}"
                    Stroke="{StaticResource EstrelaBorder}"
                    StrokeThickness="1"
                    Padding="24"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Autenticação do Operador"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource EstrelaTextPrimary}" />

                    <!-- Campo Identificador / Matrícula -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Matrícula / Usuário"
                               FontSize="14"
                               TextColor="{StaticResource EstrelaTextSecondary}" />
                        <Border BackgroundColor="{StaticResource EstrelaBackground}"
                                Stroke="{StaticResource EstrelaBorder}"
                                StrokeThickness="1"
                                Padding="12,4"
                                StrokeShape="RoundRectangle 8">
                            <Entry x:Name="LoginEntry"
                                   Text="{Binding Login}"
                                   Placeholder="Ex: OP-01 ou operador"
                                   TextColor="{StaticResource EstrelaTextPrimary}"
                                   PlaceholderColor="{StaticResource EstrelaTextSecondary}"
                                   ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Senha / PIN -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Senha / PIN"
                               FontSize="14"
                               TextColor="{StaticResource EstrelaTextSecondary}" />
                        <Border BackgroundColor="{StaticResource EstrelaBackground}"
                                Stroke="{StaticResource EstrelaBorder}"
                                StrokeThickness="1"
                                Padding="12,4"
                                StrokeShape="RoundRectangle 8">
                            <Entry x:Name="SenhaEntry"
                                   Text="{Binding Senha}"
                                   Placeholder="Digite sua senha"
                                   IsPassword="True"
                                   TextColor="{StaticResource EstrelaTextPrimary}"
                                   PlaceholderColor="{StaticResource EstrelaTextSecondary}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Feedback de Erro -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource EstrelaError}"
                           FontSize="14"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                           HorizontalTextAlignment="Center" />

                    <!-- Botão de Login -->
                    <Button x:Name="BtnEntrar"
                            Text="Acessar Bancada"
                            Clicked="OnEntrarClicked"
                            BackgroundColor="{StaticResource EstrelaAccent}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="50"
                            CornerRadius="8"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                    <!-- Activity Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource EstrelaAccent}"
                                       HeightRequest="30" />
                </VerticalStackLayout>
            </Border>

            <!-- Rodapé informativo -->
            <Label Text="Ambiente protegido • Gravador NDEF NTAG213/215"
                   FontSize="12"
                   TextColor="{StaticResource EstrelaTextSecondary}"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
