<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EstrelaClick.Mobile.FactoryMobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EstrelaClick.Mobile.FactoryMobileApp.Views"
    Title="EstrelaClick Terminal Fabril">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Bancada de Gravação"
        ContentTemplate="{DataTemplate views:BancadaPage}"
        Route="BancadaPage" />

</Shell>
