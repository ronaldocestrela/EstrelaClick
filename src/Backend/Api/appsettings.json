{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=estrelaclick;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True;Encrypt=False"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Scalar.AspNetCore": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName", "WithThreadId" ],
    "Properties": {
      "Application": "EstrelaClick.Backend.Api"
    }
  },
  "QrCode": {
    "BaseRedirecionamentoUrl": "https://estrela.click/r"
  },
  "ClientDashboard": {
    "BaseUrl": "https://localhost:7198"
  },
  "AllowedHosts": "*"
}
